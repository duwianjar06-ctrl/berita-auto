{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "git":{"deploymentEnabled":{"feature/auto-news-mvp":true}},
  "ignoreCommand":"git diff HEAD^ HEAD --quiet -- . ':!data/articles.json' ':!data/pending-articles.json'",
  "headers":[
    {"source":"/admin-berita","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"},{"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"}]},
    {"source":"/admin-berita/:path*","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"},{"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"}]}
  ]
}
